package components

templ ShortenComponent() {
	<div class="space-y-3">
		<h2 class="font-bold text-xl">Shorten a long link</h2>
		<form class="space-y-5">
			<label class="flex flex-col gap-y-0.5">
				Paste your long link here...
				<input class="border rounded-lg p-2 outline-neutral-400" placeholder="https://example.com/my-long-url" autofocus/>
			</label>
			<button type="button" class="w-full h-10 rounded-lg bg-gray-600 text-white hover:bg-black cursor-pointer">Submit</button>
		</form>
	</div>
}

templ ResolveComponent() {
	<form class=""></form>
}

templ MainComponent() {
	<main class="border-0 rounded-lg px-3 py-5 bg-zinc-300 w-[80%]">
		@ShortenComponent()
	</main>
}
